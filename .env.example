# Amendment A5: the HSE agent runs on Gemini. Server-side only — the browser must never see this,
# and the dashboard must never call the model API directly.
GEMINI_API_KEY=
# Amendment A6: used only when the Gemini budget is exhausted. Optional, but without it
# enrichment pauses instead of failing over.
ANTHROPIC_API_KEY=
EDGESENTINEL_AUTH_TOKEN=change-me-before-demo
LOG_LEVEL=INFO

# Training only — used by scripts/fetch_dataset.py, never read by the runtime pipeline.
ROBOFLOW_API_KEY=
